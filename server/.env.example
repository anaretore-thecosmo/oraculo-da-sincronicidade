# =====================================================================
# ORACULO-API — modelo de ambiente
# =====================================================================
# Destino real na VPS: /var/www/oraculo-api/.env
# Depois de criar:  chmod 600 /var/www/oraculo-api/.env
#
# Este arquivo (.env.example) vai para o Git. O .env real NUNCA vai.
# =====================================================================

NODE_ENV=production
PORT=3985

# Chave do Google AI Studio. Fica SÓ aqui, no servidor.
# Nunca no bundle do front, nunca no localStorage da visitante.
GEMINI_API_KEY=

# Modelo. Confirme com GET /api/oraculo/modelos depois do primeiro deploy
# antes de trocar por um preview. Nome errado derruba a leitura inteira.
GEMINI_MODEL=gemini-2.5-flash

# Só o domínio do Oráculo pode chamar esta API.
ALLOWED_ORIGIN=https://oraculo.portalthecosmo.com

# Teto de leituras por minuto por IP. Cada leitura custa dinheiro.
LEITURAS_POR_MINUTO=10

# Token do endpoint de diagnóstico. Gere com: openssl rand -hex 24
DIAG_TOKEN=
